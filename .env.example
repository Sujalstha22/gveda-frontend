# Backend origin the /api/* proxy forwards to (server-side only)
API_BASE_URL=https://api.gveda.com/v1/

# Base path the browser calls; proxied by next.config rewrites
NEXT_PUBLIC_API_BASE_URL=/api

# Static asset origin for image/video filenames returned by the API
NEXT_PUBLIC_STATIC_URL=https://api.gveda.com/static
